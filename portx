#!/usr/bin/env bash
# PortX — root wrapper script
# Allows running:  ./portx http 8080
# from the project root directory.
set -euo pipefail

# Resolve symlink to find the true directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Find Python 3.8+
PYTHON=""
for cmd in python3 python; do
  if command -v "$cmd" &>/dev/null; then
    ok=$("$cmd" -c "import sys; print(sys.version_info >= (3, 8))" 2>/dev/null || echo "False")
    if [ "$ok" = "True" ]; then
      PYTHON="$cmd"
      break
    fi
  fi
done

if [ -z "$PYTHON" ]; then
  echo "  ✗ Python 3.8+ is required to run PortX." >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/cli/portx.py" "$@"
